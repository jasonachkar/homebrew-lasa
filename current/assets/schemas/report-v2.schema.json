          "items": {
            "$ref": "#/$defs/Process"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "profile": {
          "type": "string"
        },
        "requested_roots": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "runtime_events": {
          "items": {
            "$ref": "#/$defs/RuntimeEvent"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "scan_id": {
          "type": "string"
        },
        "scanner_version": {
          "type": "string"
        },
        "schema": {
          "const": "lasa.report/v2"
        },
        "scope_fingerprint": {
          "type": "string"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/Service"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "sockets": {
          "items": {
            "$ref": "#/$defs/Socket"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "started": {
          "format": "date-time",
          "type": "string"
        }
