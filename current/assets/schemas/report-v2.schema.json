          "type": "integer"
        },
        "protocol": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "protocol",
        "family",
        "address",
        "port",
        "state",
        "inode",
        "namespace",
        "owners",
        "exposure"
      ],
      "type": "object"
    }
